{
  "buildCommand": "cd frontend && CI=false npm install --legacy-peer-deps && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://api.razorpay.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; img-src 'self' data: blob: https: http:; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:*; font-src 'self' https://fonts.gstatic.com data:; frame-src 'self' https://api.razorpay.com; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/payments/razorpay/webhook",
      "destination": "/api/razorpay/webhook"
    },
    {
      "source": "/api/payments/webhook",
      "destination": "/api/razorpay/webhook"
    },
    {
      "source": "/api/webhooks/razorpay-escrow",
      "destination": "/api/razorpay/webhook"
    },
    {
      "source": "/api/webhooks/razorpay-billing",
      "destination": "/api/razorpay/webhook"
    },
    {
      "source": "/api/webhooks/razorpay-payouts",
      "destination": "/api/razorpay/webhook"
    },
    {
      "source": "/api/razorpay/webhook",
      "destination": "/api/razorpay/webhook"
    },
    {
      "source": "/api/payments/create-order",
      "destination": "/api/payments/create-order"
    },
    {
      "source": "/api/payments/verify",
      "destination": "/api/payments/verify"
    },
    {
      "source": "/api/credits/send-invoice",
      "destination": "/api/credits/send-invoice"
    },
    {
      "source": "/api/credits/purchase-pack",
      "destination": "/api/credits/send-invoice"
    },
    {
      "source": "/api/credits/subscribe",
      "destination": "/api/credits/send-invoice"
    },
    {
      "source": "/api/freelancers",
      "destination": "/api/freelancers/index"
    },
    {
      "source": "/api/freelancers/:path*",
      "destination": "/api/freelancers/index"
    },
    {
      "source": "/api/admin/freelancers",
      "destination": "/api/freelancers/index"
    },
    {
      "source": "/api/admin/freelancers/:path*",
      "destination": "/api/freelancers/index"
    },
    {
      "source": "/api/freelancer/submit",
      "destination": "/api/freelancers/submit"
    },
    {
      "source": "/api/payments/list",
      "destination": "/api/payments/list"
    },
    {
      "source": "/api/admin/payments",
      "destination": "/api/payments/list"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}


